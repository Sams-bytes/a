# Aegis email outbox — copy this file to  aegis.env  and fill in your real values.
#
#   copy:   Copy-Item aegis.env.example aegis.env      (PowerShell)
#
# aegis.env is gitignored, so your password never goes into git. These settings
# are the ONE mailbox Aegis sends alerts through. Each customer still chooses
# their own destination address inside the dashboard (Email alerts page).
#
# A free, easy option is Brevo (https://www.brevo.com) — make an account, open
# "SMTP & API", and copy the SMTP server, port, login and key below.

AEGIS_SMTP_HOST=smtp-relay.brevo.com
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USER=you@yourcompany.nl
AEGIS_SMTP_PASSWORD=your-smtp-key-here
AEGIS_SMTP_FROM=alerts@yourcompany.nl
AEGIS_SMTP_SECURITY=starttls          # starttls (port 587) | ssl (port 465) | plain
AEGIS_BASE_URL=http://127.0.0.1:8000  # the link put in the email back to the dashboard
